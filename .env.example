# Jellyfin-RPC configuration.
#
# Copy to `.env` and fill in. Searched in this order:
#   1. ./.env  (working directory)
#   2. .env next to the jellyfin-rpc binary
#   3. %APPDATA%\jellyfin-rpc\.env   (Linux/macOS: ~/.config/jellyfin-rpc/.env)
# Override with `jellyfin-rpc --env-file <path>`.
#
# Real environment variables win over this file, and this file wins over main.json.
# Check what was resolved with: jellyfin-rpc --print-config


# ─── Servers ──────────────────────────────────────────────────────────────────
# Servers are polled in order. The first one with something playing wins, so put
# the one you use most first. A server that is down is skipped, not fatal.
#
# The RPC does NOT care which device plays: phone, browser and desktop app all
# produce the same Jellyfin session. What matters is that this process runs on
# the machine where the Discord client runs — Discord's IPC socket is local.
#
# Get an API key at: Dashboard -> Administration -> API Keys

# Server 1 (no number suffix)
JELLYFIN_NAME=vps
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=replace-me
# Comma separated, in priority order. Applies to every server without its own list.
JELLYFIN_USERNAME=your-jellyfin-username
JELLYFIN_SELF_SIGNED_CERT=false

# Server 2 — the Jellyfin running on this machine.
JELLYFIN_2_NAME=local
JELLYFIN_2_URL=http://localhost:8096
JELLYFIN_2_API_KEY=replace-me
# Only needed when the account name differs from JELLYFIN_USERNAME.
#JELLYFIN_2_USERNAME=other-username
#JELLYFIN_2_SELF_SIGNED_CERT=false

# Up to JELLYFIN_9_* is supported.


# ─── Runtime ──────────────────────────────────────────────────────────────────
# Seconds between polls. Lower reacts faster, higher is easier on the servers.
JELLYFIN_RPC_POLL_INTERVAL=3
# trace | debug | info | warn | error | off
# `debug` prints which server and which device each session came from.
JELLYFIN_RPC_LOG_LEVEL=info


# ─── Discord ──────────────────────────────────────────────────────────────────
# The name Discord shows after "Watching" is the name of the Discord application
# this id belongs to. To show something other than "Jellyfin", create your own
# application at https://discord.com/developers/applications and paste its id here.
DISCORD_APPLICATION_ID=1053747938519679018

# Keep the activity visible while playback is paused.
DISCORD_SHOW_PAUSED=true

# Fallback hover text for the big artwork, used when the per-category
# *_IMAGE_TEXT template renders empty.
#DISCORD_LARGE_IMAGE_TEXT=Jellyfin

# Up to two buttons. Leave unset to auto-generate them from the item's IMDb /
# TheTVDB links.
#DISCORD_BUTTON_1_NAME=My server
#DISCORD_BUTTON_1_URL=https://jellyfin.example.com
#DISCORD_BUTTON_2_NAME=dynamic
#DISCORD_BUTTON_2_URL=dynamic
# `false` removes all buttons, `true` forces two auto-generated ones.
#DISCORD_BUTTONS_DYNAMIC=true


# ─── Activity text ────────────────────────────────────────────────────────────
# Three lines per media category:
#   *_DETAILS     first line
#   *_STATE       second line
#   *_IMAGE_TEXT  hover text on the large artwork
#
# Placeholders available everywhere:
#   {title} {original-title} {genres} {year} {version}
#   {server} {username} {client} {device}   (which server / phone / app is playing)
#   {sep}   expands to the category separator; spaces around it are trimmed
#
# Movies also have:   {critic-score} {community-score} {director} {duration-minutes}
# Episodes also have: {show-title} {season} {season-padded} {episode}
#                     {episode-padded} {studio}
# Music also has:     {track} {album} {artists}
#
# *_STATUS_TYPE   which line Discord repeats in the member list: name | state | details
# *_ACTIVITY_TYPE the verb: playing | listening | watching | competing

RPC_MOVIES_DETAILS={title}
RPC_MOVIES_STATE={year} {sep} {duration-minutes}
RPC_MOVIES_IMAGE_TEXT={title}
RPC_MOVIES_SEPARATOR=" • "
RPC_MOVIES_STATUS_TYPE=details
#RPC_MOVIES_ACTIVITY_TYPE=watching

RPC_EPISODES_DETAILS={show-title}
RPC_EPISODES_STATE=S{season-padded} - E{episode-padded} {title}
RPC_EPISODES_IMAGE_TEXT={show-title}
RPC_EPISODES_SEPARATOR=" • "
RPC_EPISODES_STATUS_TYPE=details
#RPC_EPISODES_ACTIVITY_TYPE=watching

RPC_MUSIC_DETAILS={track}
RPC_MUSIC_STATE=By {artists} {sep} {album}
RPC_MUSIC_IMAGE_TEXT={album}
RPC_MUSIC_SEPARATOR=" • "
RPC_MUSIC_STATUS_TYPE=state
#RPC_MUSIC_ACTIVITY_TYPE=listening


# ─── Artwork ──────────────────────────────────────────────────────────────────
# off       no artwork, Discord shows the generic Jellyfin logo
# direct    link straight to the Jellyfin server — ONLY works if Discord's CDN
#           can reach it, so never for http://localhost:8096
# imgur     upload to imgur, needs IMGUR_CLIENT_ID, links are permanent
# litterbox upload to litterbox.catbox.moe, no account, links expire after 72h
#
# With a local server, pick imgur or litterbox.
IMAGES_HOSTING=litterbox

# https://api.imgur.com/oauth2/addclient — pick "OAuth 2 without a callback URL"
#IMGUR_CLIENT_ID=

# Where uploaded urls are remembered so the same artwork uploads only once.
# Defaults to %APPDATA%\jellyfin-rpc\urls.json
#IMAGES_CACHE_PATH=

# Fit the poster onto a 9:16 canvas before uploading.
IMAGES_PROCESS=true
# Canvas height in pixels; 512 gives 288x512.
IMAGES_SIZE=512
# Fill the sides with a blurred copy of the poster instead of transparency.
IMAGES_BG=true
# Blur radius, as a percentage of the canvas height.
IMAGES_BG_BLUR=3
# Corner rounding, as a percentage of the canvas height. Only used when IMAGES_BG=false.
IMAGES_CORNER_RADIUS=4


# ─── Blacklist ────────────────────────────────────────────────────────────────
# Never show these. Media types: movie, episode, music, livetv, book, audiobook
#BLACKLIST_MEDIA_TYPES=music,book
# Library names exactly as they appear in Jellyfin.
#BLACKLIST_LIBRARIES=Private,Home Videos
